{
  "name": "framenote",
  "version": "0.2.3",
  "description": "렌더된 영상에 프레임 단위로 메모를 남기고, 그 메모를 코딩 에이전트가 바로 받는다.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "bin": {
    "framenote": "./bin/framenote.mjs"
  },
  "files": [
    "bin",
    "dist",
    "player",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ruler": "node scripts/make-ruler-video.mjs",
    "all": "pnpm release:check && pnpm tc:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "verify:frames": "node scripts/verify-frames.mjs",
    "verify:ruler": "node scripts/verify-ruler.mjs",
    "release:check": "node scripts/check-release-contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "tc:check": "node scripts/check-tc-coverage.mjs",
    "tc:sync": "node scripts/sync-testcases.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "video",
    "review",
    "annotation",
    "remotion",
    "agent",
    "feedback"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woorichicken/framenote.git"
  },
  "homepage": "https://github.com/woorichicken/framenote#readme",
  "bugs": {
    "url": "https://github.com/woorichicken/framenote/issues"
  }
}
